# torrc — config Tor de référence pour un hidden service ADM sur NAS
#
# Ce fichier n'est PAS lu par tor-nas.sh : `install` se contente d'ajouter son
# bloc HiddenService au torrc que pose opkg, pour ne rien écraser. Cette
# config-ci est la version complète et commentée — copie-la à la main sur
# /opt/etc/tor/torrc si tu veux tout ce qu'elle contient.
#
# Les chemins sont ceux d'opkg, où /opt/etc est persistant au reboot.

# ===== Identité de l'instance =====
# On tourne en client uniquement, pas de relay, pas de bridge.
ClientOnly 1

# Pas de SOCKS proxy ouvert — on n'utilise PAS Tor pour le trafic sortant du NAS,
# uniquement pour exposer le hidden service.
SocksPort 0
ControlPort 0

# Daemonize gérée par tor-nas.sh (--runasdaemon 1 en CLI) ou par le service
# opkg S35tor selon le chemin de démarrage.
RunAsDaemon 0

# ===== Logs et données =====
DataDirectory /opt/etc/tor/data
Log notice file /opt/etc/tor/tor.log

# ===== Hidden service v3 — portail admin ADM =====
HiddenServiceDir /opt/etc/tor/hidden_service_adm/
HiddenServiceVersion 3

# Mappe le port HTTP du HS vers le portail ADM local (8000 = port ADM par défaut)
# Si tu déplaces ADM sur un autre port, ajuste ici.
HiddenServicePort 80 127.0.0.1:8000

# Si plus tard tu veux exposer ADM HTTPS aussi, décommente :
# HiddenServicePort 443 127.0.0.1:8001

# ===== Sécurité hidden service =====
# Défense anti-DoS aux points d'introduction : limite le débit des requêtes
# d'introduction qu'un client peut adresser au HS.
HiddenServiceEnableIntroDoSDefense 1

# ===== Misc =====
# Pas d'IPv6 si pas configuré côté réseau
ClientUseIPv6 0
ClientPreferIPv6ORPort 0

# Sans effet en ClientOnly ; posé pour que rien ne dépende du défaut.
ExitRelay 0

# Healthcheck via heartbeat dans les logs
HeartbeatPeriod 6 hours

# Cache hors /tmp si /tmp est en RAM ou purgé au boot — décommenter si besoin :
# CacheDirectory /opt/etc/tor/cache
