#!/usr/bin/env php
<?php
/**
 * selfrecover-su — console SuperUser du lab (modèle SU→Admin→User).
 *
 * Le SU n'existe pas en base : son secret vit hors base et hors code, et cette
 * console ne s'exécute que sur le serveur. Accès au serveur = autorisation ;
 * il n'y a aucune interface distante à attaquer.
 *
 * Seul le SU crée et révoque des administrateurs, et chaque décision est écrite
 * au journal chaîné avant d'être appliquée en base. Un `is_admin = 1` sans
 * entrée correspondante est un fantôme, que `audit` révoque et met en
 * quarantaine.
 *
 * Une fois le premier administrateur nommé (`first-admin`), la base en garde
 * toujours au moins un. Seuls `reset-shell` et `reset-db` la ramènent à zéro,
 * et rouvrent l'amorçage.
 */

declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "CLI uniquement.\n");
    exit(1);
}

require __DIR__ . '/lib/db.php';
require __DIR__ . '/lib/su_audit.php';
require __DIR__ . '/lib/diceware/wordlist.php';

use Pierroons\MySelfLab\Db;
use Pierroons\MySelfLab\SuAudit;

const SU_DEMO_SECRET = 'demo-su-secret';

$argv0 = 'selfrecover-su';
$cmd   = $argv[1] ?? '';

function su_fail(string $m, int $code = 1): void
{
    fwrite(STDERR, "❌ $m\n");
    exit($code);
}

function su_ok(string $m): void
{
    fwrite(STDOUT, "✅ $m\n");
}

/** Saisie non affichée : protège la passphrase de l'épaule, du screenshot et de l'historique. */
function su_prompt_hidden(string $label): string
{
    fwrite(STDOUT, $label);
    $tty = stripos(PHP_OS, 'WIN') === false && @shell_exec('stty 2>/dev/null') !== null;
    if ($tty) {
        @shell_exec('stty -echo 2>/dev/null');
    }
    $v = rtrim((string) fgets(STDIN), "\r\n");
    if ($tty) {
        @shell_exec('stty echo 2>/dev/null');
        fwrite(STDOUT, "\n");
    }

    return $v;
}

function su_secret_path(): string
{
    return getenv('SELFRECOVER_SU_SECRET_FILE')
        ?: ((getenv('SELFRECOVER_STATE_DIR') ?: SuAudit::stateFallback()) . '/su-secret');
}

/** Le fichier prime sur l'environnement : `change-passphrase` écrit le premier, l'install pose le second. */
function su_expected_secret(): ?string
{
    $f = su_secret_path();
    if (is_file($f)) {
        $h = trim((string) @file_get_contents($f));
        if ($h !== '') {
            return $h;
        }
    }
    $e = getenv('SELFRECOVER_SU_SECRET');

    return ($e !== false && $e !== '') ? $e : null;
}

/**
 * Empreinte du secret attendu à cet instant, et d'où il vient.
 *
 * ⚠️ **Pèse le secret, pas le fichier.** Une installation qui pose
 * `SELFRECOVER_SU_SECRET` n'a pas de fichier ; peser le fichier y rendait `null`
 * pour toujours, donc un `verify-log` qui avertit à chaque exécution et un
 * `record-seal` qui refuse — une alarme qu'aucun geste n'éteint s'ignore, ce qui
 * est exactement ce que ce mécanisme cherche à éviter.
 *
 * `null` uniquement quand il n'y a aucun secret configuré : là, il n'y a rien à
 * comparer.
 *
 * @return array{empreinte: string, source: string}|null
 */
function su_empreinte_secret(): ?array
{
    $attendu = su_expected_secret();
    if ($attendu === null) {
        return null;
    }
    $f      = su_secret_path();
    $source = (is_file($f) && trim((string) @file_get_contents($f)) !== '')
        ? basename($f)
        : 'SELFRECOVER_SU_SECRET';

    return ['empreinte' => SuAudit::empreinteDe($attendu), 'source' => $source];
}

/**
 * @return string la passphrase en clair — nécessaire pour dériver la clé de
 *                sauvegarde, à effacer dès que le dérivé est obtenu.
 */
function su_authenticate(): string
{
    $expected = su_expected_secret();
    if ($expected === null) {
        su_fail('Secret SU non configuré (ni ' . su_secret_path() . ', ni SELFRECOVER_SU_SECRET) — à poser à l\'installation.', 2);
    }
    $given = getenv('SELFRECOVER_SU_SECRET_INPUT');
    if ($given === false) {
        $given = su_prompt_hidden('Passphrase SuperUser : ');
    }
    $isHash = preg_match('/^\$(argon2|2y|2a|2b)/', (string) $expected) === 1;
    $ok = $isHash
        ? password_verify((string) $given, (string) $expected)
        : hash_equals((string) $expected, (string) $given);
    if (!$ok) {
        su_fail('Secret SU invalide.', 3);
    }

    // 🔑 On le dit, on ne le réécrit pas. Un hash rangé en base voit son profil
    // comparé à chaque connexion réussie ; ce secret-là vit seul dans un fichier
    // et personne ne lui posait la question — il est resté trois semaines en
    // `p=1` quand la bibliothèque déclarait `p=2`. Reposer le secret reste un
    // geste humain : `change-passphrase` le fait, et il le journalise.
    if ($isHash) {
        // Les trois réponses de `su_profil_perime()` restent trois jusqu'ici. Taire
        // le `null` rendrait le même silence que « conforme » — sur une console
        // déployée sans la bibliothèque, l'opérateur en conclurait que son profil
        // est à jour, ce qui est la situation d'origine sous une nouvelle forme.
        $perime = su_profil_perime((string) $expected);
        if ($perime === true) {
            fwrite(
                STDERR,
                "⚠️  Le secret SU suit un profil Argon2id périmé — relance « change-passphrase ».\n"
            );
        } elseif ($perime === null) {
            fwrite(
                STDERR,
                "⚠️  Profil du secret SU NON VÉRIFIÉ : bibliothèque SelfRecover introuvable"
                . " depuis cette console.\n"
            );
        }
    }

    return (string) $given;
}

/** Efface une valeur sensible de la mémoire, avec le repli de `Primitives::zeroize()`. */
function su_zeroize(string &$v): void
{
    if (function_exists('sodium_memzero')) {
        sodium_memzero($v);

        return;
    }
    $v = str_repeat("\0", strlen($v));
}

/**
 * Une passphrase qui sert de CLÉ doit résister hors ligne, où aucun compteur
 * d'essais ne s'applique. Deux voies mesurables, sans estimateur maison :
 * quatre mots de la liste EFF (≈ 51,7 bits), ou une longueur qui ne se devine
 * pas. Le seuil de huit caractères de l'ancienne console tombait en secondes.
 */
function su_check_passphrase(string $p): void
{
    $words = preg_split('/\s+/', trim($p), -1, PREG_SPLIT_NO_EMPTY) ?: [];
    if (count($words) >= 4) {
        $inList = true;
        foreach ($words as $w) {
            if (!DicewareWordlist::contains(strtolower($w), 'en') && !DicewareWordlist::contains(strtolower($w), 'fr')) {
                $inList = false;
                break;
            }
        }
        if ($inList) {
            return;
        }
    }
    if (mb_strlen($p) >= 20) {
        return;
    }
    su_fail(
        "Passphrase trop faible pour chiffrer une sauvegarde.\n"
        . "   → soit 4 mots ou plus de la liste diceware EFF (« cheval agrafe pile batterie »),\n"
        . '   → soit 20 caractères au minimum.'
    );
}

function su_find_account(PDO $db, string $username): ?array
{
    $st = $db->prepare('SELECT id, username, is_admin FROM accounts WHERE username = ?');
    $st->execute([$username]);

    return $st->fetch() ?: null;
}

/**
 * Clé de chiffrement de la sauvegarde, dérivée de la passphrase SU par Argon2id
 * avec un sel propre à chaque fichier.
 *
 * L'ancienne dérivation était un SHA-256 sans sel, sur un fichier que la console
 * elle-même destine au hors-site : une passphrase courte y tombait en secondes,
 * et l'absence de sel rendait les sauvegardes de déployeurs différents
 * attaquables d'un seul calcul. Le sel voyage dans l'en-tête `SRSU2`.
 */
function su_backup_key(string $passphrase, string $salt): string
{
    return sodium_crypto_pwhash(
        32,
        $passphrase,
        $salt,
        SODIUM_CRYPTO_PWHASH_OPSLIMIT_MODERATE,
        SODIUM_CRYPTO_PWHASH_MEMLIMIT_MODERATE,
        SODIUM_CRYPTO_PWHASH_ALG_ARGON2ID13
    );
}

/** Dérivation de l'ancien format, conservée en lecture seule pour rouvrir les sauvegardes déjà produites. */
function su_backup_key_legacy(string $passphrase): string
{
    return hash('sha256', $passphrase . '|su-audit-backup', true);
}

/**
 * Le profil Argon2id du dépôt, pour hacher le secret SU.
 *
 * 🔑 Ce secret est le plus privilégié du modèle, et c'était le seul hachage du
 * dépôt à ne pas lire ce profil : `password_hash($p, PASSWORD_ARGON2ID)` sans
 * options prend ceux de PHP. Aujourd'hui les deux coïncident sur la mémoire et
 * les itérations et diffèrent d'un fil (p=1 contre p=2) — c'est la coïncidence
 * qui tenait, pas une décision. Le jour où le profil monte, ce secret-là serait
 * resté seul en arrière, sans que rien ne le dise.
 *
 * ⚠️ On échoue plutôt que de se rabattre sur un profil écrit ici : deux valeurs
 * pour une même règle, c'est la divergence qu'on vient de fermer. Une console
 * qui ne trouve pas la bibliothèque ne doit pas poser un secret dont personne
 * ne connaît le coût.
 *
 * La vérification, elle, ne dépend pas de ceci : `password_verify` lit les
 * paramètres DANS l'empreinte stockée. Un secret posé avant ce correctif
 * continue donc de s'authentifier ; seul un `change-passphrase` le réécrit.
 */
function su_classe_hachage(): ?string
{
    $classe = 'Pierroons\\SelfRecover\\Crypto\\Hashing';
    if (!class_exists($classe)) {
        // Le CLI ne charge pas Composer — il doit tourner là où seule la
        // bibliothèque est déposée. Son autoload sans Composer suffit.
        foreach ([
            __DIR__ . '/vendor/pierroons/selfrecover/src/autoload.php',
            __DIR__ . '/../../bi-self/selfrecover/src/autoload.php',
        ] as $chemin) {
            if (is_file($chemin)) {
                require_once $chemin;
                break;
            }
        }
    }

    return class_exists($classe) ? $classe : null;
}

function su_argon2_options(): array
{
    $classe = su_classe_hachage();
    if ($classe === null) {
        su_fail(
            'Profil de hachage introuvable : la bibliothèque SelfRecover n\'est pas'
            . ' chargeable depuis cette console. Refus de poser un secret SU dont le'
            . ' coût ne serait pas celui du dépôt.',
            78
        );
    }

    return $classe::ARGON2;
}

/**
 * Le hash suit-il encore le profil du dépôt ? `null` quand la bibliothèque n'est
 * pas chargeable.
 *
 * ⚠️ Les trois réponses sont distinctes et le restent : « conforme », « périmé »
 * et « je ne sais pas ». Rabattre la troisième sur la première rendrait le même
 * silence qu'un contrôle réussi, ce qui est exactement le défaut qu'on ferme ici.
 */
function su_profil_perime(string $hash): ?bool
{
    $classe = su_classe_hachage();

    return $classe === null ? null : $classe::needsRehash($hash);
}

/**
 * Met un fichier de côté sous un nom horodaté, sans jamais le détruire.
 *
 * @return string|null le nouveau chemin, ou `null` si le fichier n'existait pas
 */
function su_figer(string $chemin, string $horodatage): ?string
{
    if (!file_exists($chemin)) {
        return null;
    }
    $fige = $chemin . '.frozen-' . $horodatage;
    if (!@rename($chemin, $fige)) {
        su_fail("Impossible de mettre $chemin de côté — rien n'a été supprimé.");
    }
    @chmod($fige, 0600);

    return $fige;
}

function su_nb_admins(PDO $db): int
{
    return (int) $db->query('SELECT COUNT(*) FROM accounts WHERE is_admin = 1')->fetchColumn();
}

/** Rappelle le dernier `reset-db` en tête des commandes qui parlent des admins. */
function su_rappel_reset_db(): void
{
    $r = SuAudit::dernierResetDb();
    if ($r === null) {
        return;
    }
    fwrite(STDOUT, sprintf(
        "🔴 Dernier reset-db : %s — %d compte(s) supprimé(s). Détail : `show-log`.\n",
        $r['ts_paris'] ?? '?',
        (int) ($r['extra']['comptes'] ?? 0)
    ));
}

// ─── Garde-fou de démarrage ──────────────────────────────────────────────────
// Le régime strict est le défaut : contourner demande un geste conscient, parce
// qu'un déploiement qui ne pose rien ne doit pas hériter des valeurs de démonstration.
if (!SuAudit::devMode()) {
    if (su_expected_secret() === SU_DEMO_SECRET) {
        su_fail('Secret SU = valeur de démonstration. Lance `change-passphrase`, ou pose un hash Argon2id.', 78);
    }
    // `secretPose()` et non `secret()` : depuis que le refus est DANS la fonction,
    // l'appeler ici ferait remonter une exception à la place de ce message-ci — qui
    // dit, lui, quoi faire. Le prédicat laisse la console garder sa voix.
    if (!SuAudit::secretPose()) {
        su_fail('SELFRECOVER_SU_AUDIT_SECRET absent ou laissé à sa valeur de démonstration — à fixer à l\'installation.', 78);
    }
    $state = dirname(su_secret_path());
    if (is_dir($state) && str_starts_with(realpath($state) ?: $state, realpath(__DIR__) ?: __DIR__)) {
        su_fail(
            "Le secret SU vit sous l'arborescence du module ($state), donc potentiellement sous une racine web.\n"
            . '   → pose SELFRECOVER_STATE_DIR sur un dossier hors du site.',
            78
        );
    }
}

switch ($cmd) {
    case 'first-admin':
        // L'amorçage : sans lui, personne ne pourrait déposer la première demande
        // de promotion. Il sert une fois, puis seul un reset le rouvre.
        su_authenticate();
        $u   = $argv[2] ?? su_fail("usage: $argv0 first-admin <username>");
        $db  = Db::pdo();
        $nb  = su_nb_admins($db);
        if (SuAudit::firstAdminConsomme()) {
            if ($nb === 0) {
                su_fail(
                    "Aucun administrateur en base, alors que le journal a déjà vu le premier.\n"
                    . "   La base a perdu ses admins par un chemin qui n'est pas un reset : la voie ne se rouvre pas\n"
                    . "   d'elle-même. Restaure la base, ou `reset-shell` (passphrase SU perdue), ou `reset-db`\n"
                    . '   (compromission).',
                    5
                );
            }
            su_fail(
                "Le premier administrateur est déjà nommé. Les suivants passent par une demande d'un\n"
                . "   admin (`list-requests`), que tu tranches par `approve-request`."
            );
        }
        if ($nb > 0) {
            su_fail("$nb administrateur(s) en base sans amorçage au journal — lance `audit`.", 5);
        }
        $acc = su_find_account($db, $u) ?: su_fail("Compte « $u » introuvable — il doit s'inscrire d'abord.");
        SuAudit::append(SuAudit::ACTION_FIRST_ADMIN, $u);
        $db->prepare('UPDATE accounts SET is_admin = 1 WHERE id = ?')->execute([$acc['id']]);
        su_ok("« $u » est le premier administrateur (journalisé). La voie `first-admin` est close.");
        break;

    case 'add-admin':
        su_fail(
            "`add-admin` ne promeut plus.\n"
            . "   Premier administrateur : `$argv0 first-admin <username>`.\n"
            . "   Les suivants : un admin dépose la demande, tu la tranches par `approve-request`."
        );
        break;

    case 'revoke-admin':
        su_authenticate();
        $u   = $argv[2] ?? su_fail("usage: $argv0 revoke-admin <username> [--remplacant <username>]");
        $pos = array_search('--remplacant', $argv, true);
        $r   = $pos !== false ? ($argv[$pos + 1] ?? su_fail('--remplacant attend un nom de compte.')) : null;
        $db  = Db::pdo();
        $acc = su_find_account($db, $u) ?: su_fail("Compte « $u » introuvable.");
        if ((int) $acc['is_admin'] !== 1) {
            su_fail("« $u » n'est pas administrateur.");
        }

        if ($r === null) {
            if (su_nb_admins($db) <= 1) {
                su_fail(
                    "« $u » est le dernier administrateur : il ne se révoque pas seul.\n"
                    . "   → `$argv0 revoke-admin $u --remplacant <username>` nomme son successeur dans le même geste.",
                    6
                );
            }
            SuAudit::append(SuAudit::ACTION_REVOKE_ADMIN, $u);
            $db->prepare('UPDATE accounts SET is_admin = 0 WHERE id = ?')->execute([$acc['id']]);
            $db->prepare('DELETE FROM app_sessions WHERE account_id = ?')->execute([$acc['id']]);
            su_ok("« $u » révoqué — sessions coupées, journalisé.");
            break;
        }

        $rem = su_find_account($db, $r) ?: su_fail("Remplaçant « $r » introuvable.");
        if ((int) $rem['is_admin'] === 1) {
            su_fail("« $r » est déjà administrateur : révoque « $u » sans --remplacant.");
        }
        SuAudit::append(SuAudit::ACTION_REPLACE_ADMIN, $u, ['revoque' => $u, 'promu' => $r]);
        // Promouvoir d'abord : l'ordre inverse ferait passer la base par zéro
        // admin, et la garde de `Db::migrate()` refuserait la transaction.
        $db->beginTransaction();
        $db->prepare('UPDATE accounts SET is_admin = 1 WHERE id = ?')->execute([$rem['id']]);
        $db->prepare('UPDATE accounts SET is_admin = 0 WHERE id = ?')->execute([$acc['id']]);
        $db->prepare('DELETE FROM app_sessions WHERE account_id = ?')->execute([$acc['id']]);
        $db->commit();
        su_ok("« $u » révoqué et remplacé par « $r » — sessions de « $u » coupées, journalisé.");
        break;

    case 'list-admins':
        su_authenticate();
        su_rappel_reset_db();
        $rows = Db::pdo()->query('SELECT username FROM accounts WHERE is_admin = 1 ORDER BY username')->fetchAll();
        if (!$rows) {
            fwrite(STDOUT, "Aucun administrateur.\n");
            break;
        }
        fwrite(STDOUT, 'Administrateurs (' . count($rows) . ") :\n");
        foreach ($rows as $r) {
            fwrite(STDOUT, "  · {$r['username']}\n");
        }
        break;

    case 'list-requests':
        su_authenticate();
        $rows = Db::pdo()->query(
            "SELECT id, requester_username, target_username, reason, created_at
               FROM admin_requests WHERE status = 'pending' ORDER BY id"
        )->fetchAll();
        if (!$rows) {
            fwrite(STDOUT, "Aucune demande en attente.\n");
            break;
        }
        fwrite(STDOUT, "Demandes en attente :\n");
        foreach ($rows as $r) {
            fwrite(STDOUT, sprintf(
                "  #%d  %s → promouvoir %s%s  [%s]\n",
                $r['id'],
                $r['requester_username'],
                $r['target_username'],
                $r['reason'] ? "  ({$r['reason']})" : '',
                date('Y-m-d H:i', (int) $r['created_at'])
            ));
        }
        break;

    case 'approve-request':
        su_authenticate();
        $id   = $argv[2] ?? su_fail("usage: $argv0 approve-request <id> \"<observation>\"");
        $note = $argv[3] ?? su_fail('Observation obligatoire : le SU dit pourquoi il tranche.');
        $db   = Db::pdo();
        $st   = $db->prepare("SELECT * FROM admin_requests WHERE id = ? AND status = 'pending'");
        $st->execute([$id]);
        $req = $st->fetch() ?: su_fail("Demande #$id introuvable ou déjà traitée.");
        $acc = su_find_account($db, $req['target_username'])
            ?: su_fail("Cible « {$req['target_username']} » introuvable — le compte a disparu depuis la demande.");

        SuAudit::append(SuAudit::ACTION_APPROVE_REQUEST, $req['target_username'], [
            'request_id'   => (int) $id,
            'requester'    => $req['requester_username'],
            'reason'       => $req['reason'],
            'requested_at' => (int) $req['created_at'],
            'su_note'      => $note,
        ]);
        $db->beginTransaction();
        $db->prepare('UPDATE accounts SET is_admin = 1 WHERE id = ?')->execute([$acc['id']]);
        $db->prepare("UPDATE admin_requests SET status = 'approved', su_note = ?, decided_at = ? WHERE id = ?")
            ->execute([$note, time(), $id]);
        $db->commit();
        su_ok("Demande #$id approuvée — « {$req['target_username']} » promu administrateur.");
        break;

    case 'reject-request':
        su_authenticate();
        $id   = $argv[2] ?? su_fail("usage: $argv0 reject-request <id> \"<observation>\"");
        $note = $argv[3] ?? su_fail('Observation obligatoire.');
        $db   = Db::pdo();
        $st   = $db->prepare("SELECT * FROM admin_requests WHERE id = ? AND status = 'pending'");
        $st->execute([$id]);
        $req = $st->fetch() ?: su_fail("Demande #$id introuvable ou déjà traitée.");

        SuAudit::append(SuAudit::ACTION_REJECT_REQUEST, $req['target_username'], [
            'request_id'   => (int) $id,
            'requester'    => $req['requester_username'],
            'reason'       => $req['reason'],
            'requested_at' => (int) $req['created_at'],
            'su_note'      => $note,
        ]);
        $db->prepare("UPDATE admin_requests SET status = 'rejected', su_note = ?, decided_at = ? WHERE id = ?")
            ->execute([$note, time(), $id]);
        su_ok("Demande #$id refusée (journalisé).");
        break;

    case 'audit':
        su_authenticate();
        $dryRun = in_array('--dry-run', $argv, true);
        $db     = Db::pdo();
        $admins = array_column($db->query('SELECT username FROM accounts WHERE is_admin = 1')->fetchAll(), 'username');
        $ghosts = array_values(array_diff($admins, array_keys(SuAudit::adminsLegitimes())));

        su_rappel_reset_db();
        $ver = SuAudit::verify();
        fwrite(STDOUT, 'Journal : ' . ($ver['ok']
            ? "✅ intègre ({$ver['count']} entrées)"
            : "🚨 ROMPU à l'entrée {$ver['break_at']} — {$ver['reason']}") . "\n");

        if ($ghosts && count($ghosts) === count($admins) && !$dryRun) {
            // Tout mettre en quarantaine laisserait la base sans admin. Un contrôle
            // qui veut tout retirer a plus probablement une entrée cassée — journal
            // tronqué, remplacé, lu au mauvais endroit — qu'une base envahie.
            fwrite(STDOUT, '🚨 TOUS les administrateurs (' . count($admins) . ') sont absents du journal : '
                . implode(', ', $ghosts) . "\n");
            su_fail(
                "Quarantaine refusée : elle ne laisserait aucun administrateur.\n"
                . "   L'entrée est plus probablement cassée qu'envahie : `verify-log`, puis `restore-log`\n"
                . '   depuis une sauvegarde. Si la base est réellement compromise : `reset-db`.',
                7
            );
        }
        if ($ghosts) {
            fwrite(STDOUT, "🚨 ADMINISTRATEUR(S) FANTÔME(S) — is_admin = 1 sans entrée de création :\n");
            foreach ($ghosts as $g) {
                if ($dryRun) {
                    fwrite(STDOUT, "   ⚠️  $g  (--dry-run : non bloqué)\n");
                    continue;
                }
                SuAudit::append(SuAudit::ACTION_QUARANTINE, $g, ['reason' => 'is_admin=1 sans entrée de création au journal']);
                $db->prepare('UPDATE accounts SET is_admin = 0 WHERE username = ?')->execute([$g]);
                $db->prepare('DELETE FROM app_sessions WHERE account_id = (SELECT id FROM accounts WHERE username = ?)')
                    ->execute([$g]);
                fwrite(STDOUT, "   🔒 $g → quarantaine (droits révoqués, sessions coupées, journalisé)\n");
            }
            exit(4);
        }
        fwrite(STDOUT, '✅ Aucun fantôme : les ' . count($admins) . " administrateur(s) en base correspondent au journal.\n");
        break;

    case 'verify-log':
        su_authenticate();
        su_rappel_reset_db();
        $ver = SuAudit::verify();
        if (!$ver['ok']) {
            su_fail("🚨 Chaîne ROMPUE à l'entrée {$ver['break_at']} : {$ver['reason']}", 4);
        }

        // Deux questions distinctes, et « intègre » ne répond qu'à la première : la
        // chaîne a-t-elle bougé, et le secret en place est-il celui qu'on a vu poser ?
        // Un journal parfaitement intègre peut n'avoir jamais vu passer le secret qui
        // garde la console — c'est ce qui est arrivé le 09/09/2026, où un hash a été
        // déposé à la main sans laisser d'entrée.
        $sceau = SuAudit::dernierSceau();
        $etat  = su_empreinte_secret();

        if ($sceau !== null && $etat !== null && !hash_equals($sceau['empreinte'], $etat['empreinte'])) {
            // ⚠️ Le désaccord est un fait ; sa cause n'en est pas un. Trois chemins y
            // mènent, et n'en nommer qu'un ferait accuser à tort un journal complet.
            su_fail(
                "🚨 Le secret SU en place ne correspond pas au dernier sceau connu,"
                . " celui du {$sceau['ts_paris']}.\n"
                . "   Trois causes y mènent : un remplacement hors de `change-passphrase` ;"
                . " une console qui lit\n"
                . "   un autre SELFRECOVER_SU_SECRET_FILE ; un `change-passphrase` lancé"
                . " depuis une copie du\n"
                . "   script antérieure au sceau. Si ce changement est le tien : `record-seal`.",
                5
            );
        }

        su_ok("Chaîne intègre — {$ver['count']} entrées, aucune altération.");

        // 🔑 « Intègre » ne répond pas à la troisième question : le témoin distant
        // a-t-il vu passer ces entrées ? La chaîne se vérifie de l'intérieur, donc
        // elle ne détecte pas sa propre troncature — le préfixe d'une chaîne valide
        // est une chaîne valide. Seule la marque du témoin, qui vit HORS du journal,
        // rend visible un journal raccourci ou un témoin devenu muet.
        // Placé AVANT le bloc du sceau, qui sort par `break` dans le cas nominal :
        // écrit après, ce contrôle ne se serait jamais affiché quand tout va bien.
        $tem = SuAudit::ecartTemoin();
        switch ($tem['etat']) {
            case 'tronque':
                // Le journal est plus court que ce que le témoin a confirmé. Ce n'est
                // pas un soupçon, c'est une preuve : la marque est extérieure au fichier.
                su_fail("🚨 JOURNAL RACCOURCI — {$tem['detail']}", 5);
                // no break
            case 'jamais':
            case 'muet':
                fwrite(STDERR, "   ⚠️  Témoin distant : {$tem['detail']}.\n");
                fwrite(STDERR, "      Tant qu'il se tait, une troncature du journal ne se verrait de nulle part.\n");
                break;
            case 'non_configure':
                fwrite(STDERR, "   ⚠️  {$tem['detail']}.\n");
                break;
            default:
                fwrite(STDOUT, "   Témoin distant : {$tem['detail']}.\n");
        }

        if ($sceau !== null && $etat !== null) {
            fwrite(
                STDOUT,
                "   Secret SU conforme au sceau du {$sceau['ts_paris']}"
                . " ({$sceau['action']}, source : {$etat['source']}).\n"
            );
            break;
        }

        // 🔑 Un code de sortie à part, et c'est le cœur du contrôle. Le premier jet
        // écrivait ces deux lignes sur STDERR et sortait à 0, comme le cas vérifié :
        // une tâche planifiée qui alerte sur un code non nul n'aurait jamais rien vu,
        // et le faux vert que ce mécanisme ferme se serait logé dans le mécanisme.
        $cause = $etat === null
            ? 'aucun secret SU configuré — rien à peser'
            : 'aucune entrée du journal ne porte d\'empreinte de secret';
        fwrite(STDERR, "   SCEAU NON VÉRIFIÉ : {$cause}.\n");
        fwrite(STDERR, "   La concordance du secret en place reste à établir — `record-seal` la pose.\n");
        exit(6);

    case 'record-seal':
        // Constat, pas mutation : le secret ne change pas, on note seulement à quoi
        // il ressemblait ce jour-là. C'est le geste qui amorce le contrôle sur une
        // console dont le secret a été posé avant que ce champ existe.
        su_authenticate();
        $etat = su_empreinte_secret();
        if ($etat === null) {
            su_fail('Aucun secret SU configuré — rien à sceller.', 2);
        }
        $connu = SuAudit::dernierSceau();
        if ($connu !== null && hash_equals($connu['empreinte'], $etat['empreinte'])) {
            su_ok("Déjà scellé — ce secret est celui du {$connu['ts_paris']}. Rien à noter.");
            break;
        }
        SuAudit::append(SuAudit::ACTION_RECORD_SEAL, 'SU', [
            'source'    => $etat['source'],
            'empreinte' => $etat['empreinte'],
            'remplace'  => $connu !== null ? $connu['ts_paris'] : null,
        ]);
        // Amorcer un contrôle et acquitter une alarme sont deux gestes : le second
        // clôt un désaccord que `verify-log` signalait, et l'opérateur doit lire
        // qu'il vient de le faire. L'ancien sceau reste au journal dans les deux cas.
        if ($connu !== null) {
            su_ok(
                "Sceau REMPLACÉ — le désaccord avec celui du {$connu['ts_paris']} est acquitté."
                . " L'ancien reste au journal."
            );
        } else {
            su_ok('Sceau posé — `verify-log` peut désormais dire si ce secret change.');
        }
        break;

    case 'show-log':
    case 'log':
        su_authenticate();
        $logPath = SuAudit::logPath();
        if (!file_exists($logPath)) {
            su_fail("Aucun journal ($logPath).");
        }
        $lines = file($logPath, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
        $limit = isset($argv[2]) ? max(1, (int) $argv[2]) : count($lines);
        $slice = array_slice($lines, -$limit);

        fwrite(STDOUT, 'Journal SU — ' . count($lines) . ' entrée(s)'
            . ($limit < count($lines) ? " (dernières $limit)" : '') . " · $logPath\n");
        fwrite(STDOUT, str_repeat('─', 60) . "\n");
        foreach ($slice as $line) {
            $e = json_decode($line, true);
            if (!is_array($e)) {
                fwrite(STDOUT, "  ⚠ ligne illisible\n");
                continue;
            }
            $f   = $e['forensic'] ?? [];
            $who = ($f['mode'] ?? '') === 'minimal'
                ? 'contexte réduit'
                : (!empty($f['operator']) ? $f['operator'] . '  ·  ' : '')
                    . ($f['unix_user'] ?? '?') . '@' . ($f['ssh_client_ip'] ?: 'local')
                    . ' tty=' . ($f['tty'] ?? '?') . ' pid=' . ($f['pid'] ?? '?');

            if (($e['action'] ?? '') === SuAudit::ACTION_RESET_DB) {
                fwrite(STDOUT, str_repeat('━', 60) . "\n");
                fwrite(STDOUT, "🔴 RESET-DB — tous les comptes supprimés\n");
            }
            fwrite(STDOUT, sprintf(
                "#%-3s %s  %s%s\n",
                $e['seq'] ?? '?',
                $e['ts_paris'] ?? ($e['ts_utc'] ?? '?'),
                $e['action'] ?? '?',
                isset($e['target']) && $e['target'] !== '' ? " → {$e['target']}" : ''
            ));
            foreach (($e['extra'] ?? []) as $k => $v) {
                if (is_scalar($v)) {
                    fwrite(STDOUT, "     $k : $v\n");
                }
            }
            fwrite(STDOUT, "     par  : $who\n");
            fwrite(STDOUT, '     hash : ' . substr($e['entry_hash'] ?? '', 0, 12) . '…  hmac '
                . substr($e['hmac'] ?? '', 0, 12) . "…\n");
            if (($e['action'] ?? '') === SuAudit::ACTION_RESET_DB) {
                fwrite(STDOUT, str_repeat('━', 60) . "\n");
            }
        }
        fwrite(STDOUT, str_repeat('─', 60) . "\n");
        fwrite(STDOUT, "Intégrité : `$argv0 verify-log` contrôle la chaîne.\n");
        break;

    case 'change-passphrase':
    case 'set-passphrase':
        su_authenticate();
        $n1 = getenv('SELFRECOVER_SU_NEW_INPUT');
        if ($n1 === false) {
            $n1 = su_prompt_hidden('Nouvelle passphrase SU : ');
            $n2 = su_prompt_hidden('Confirme la nouvelle passphrase : ');
            if ($n1 !== $n2) {
                su_fail('Les deux saisies diffèrent — rien changé.');
            }
        }
        su_check_passphrase((string) $n1);
        $secPath = su_secret_path();
        if (!is_dir(dirname($secPath)) && !@mkdir(dirname($secPath), 0700, true)) {
            su_fail('Dossier d\'état introuvable et non créable : ' . dirname($secPath));
        }
        $newHash = password_hash((string) $n1, PASSWORD_ARGON2ID, su_argon2_options());
        if (@file_put_contents($secPath, $newHash) === false) {
            su_fail("Écriture impossible : $secPath.");
        }
        @chmod($secPath, 0600);
        // L'empreinte du hash posé, et non le hash : elle suffit à reconnaître le
        // secret en place, et elle entre dans `extra`, donc dans la chaîne et sous
        // le HMAC. Sans elle le journal peut attester de sa propre intégrité tout
        // en ignorant que le secret qu'il protège a été remplacé en dehors de lui.
        SuAudit::append(SuAudit::ACTION_CHANGE_PASS, 'SU', [
            'store'     => basename($secPath),
            'algo'      => 'argon2id',
            'empreinte' => SuAudit::empreinteDe($newHash),
        ]);
        su_ok("Passphrase SU changée — hash Argon2id dans $secPath. L'ancienne ne vaut plus rien.");
        break;

    case 'backup-log':
        $pass    = su_authenticate();
        $dest    = $argv[2] ?? su_fail("usage: $argv0 backup-log <fichier-destination>");
        $logPath = SuAudit::logPath();
        if (!file_exists($logPath)) {
            su_fail("Aucun journal à sauvegarder ($logPath).");
        }
        su_check_passphrase($pass);

        $salt   = random_bytes(SODIUM_CRYPTO_PWHASH_SALTBYTES);
        $key    = su_backup_key($pass, $salt);
        su_zeroize($pass);
        $iv     = random_bytes(12);
        $tag    = '';
        $cipher = openssl_encrypt(
            (string) file_get_contents($logPath),
            'aes-256-gcm',
            $key,
            OPENSSL_RAW_DATA,
            $iv,
            $tag
        );
        su_zeroize($key);
        if ($cipher === false) {
            su_fail('Chiffrement échoué.');
        }
        $sealed = "SRSU2\n" . base64_encode($salt) . "\n" . base64_encode($iv) . "\n"
            . base64_encode($tag) . "\n" . base64_encode($cipher) . "\n";
        if (@file_put_contents($dest, $sealed) === false) {
            su_fail("Écriture $dest impossible.");
        }
        @chmod($dest, 0600);
        SuAudit::append(SuAudit::ACTION_BACKUP_LOG, basename($dest));
        su_ok("Journal scellé → $dest (AES-256-GCM, clé Argon2id salée).");
        fwrite(STDOUT, "   → à copier hors-site. Restauration : $argv0 restore-log $dest\n");
        break;

    case 'restore-log':
        $pass = su_authenticate();
        $src  = $argv[2] ?? su_fail("usage: $argv0 restore-log <fichier-scellé>");
        if (!file_exists($src)) {
            su_fail("Fichier introuvable : $src.");
        }
        $lines  = file($src, FILE_IGNORE_NEW_LINES);
        $format = $lines[0] ?? '';
        if ($format === 'SRSU2') {
            $key    = su_backup_key($pass, base64_decode($lines[1] ?? ''));
            $iv     = base64_decode($lines[2] ?? '');
            $tag    = base64_decode($lines[3] ?? '');
            $cipher = base64_decode($lines[4] ?? '');
        } elseif ($format === 'SRSU1') {
            // Sauvegardes produites avant le salage. Lisibles, jamais réécrites
            // dans cet ancien format : `backup-log` ne produit plus que du SRSU2.
            $key    = su_backup_key_legacy($pass);
            $iv     = base64_decode($lines[1] ?? '');
            $tag    = base64_decode($lines[2] ?? '');
            $cipher = base64_decode($lines[3] ?? '');
            fwrite(STDERR, "⚠️  Format SRSU1 (clé non salée) — rescelle ce journal avec `backup-log`.\n");
        } else {
            su_fail('Format scellé inconnu.');
        }
        su_zeroize($pass);
        $plain = openssl_decrypt($cipher, 'aes-256-gcm', $key, OPENSSL_RAW_DATA, $iv, $tag);
        su_zeroize($key);
        if ($plain === false) {
            su_fail('Déchiffrement échoué (mauvaise passphrase ou fichier altéré).', 4);
        }
        fwrite(STDOUT, $plain);
        break;

    case 'forgot-passphrase':
    case 'reset-shell':
        // Coquille vide : la passphrase est perdue, donc elle ne peut pas être
        // exigée. L'accès au serveur fait autorisation — choix assumé, borné par
        // ce qu'il ne peut pas faire : il ne promeut personne, et l'ancien
        // journal est figé et renommé, jamais détruit.
        if (!in_array('--confirm', $argv, true)) {
            fwrite(STDOUT, "⚠️  COQUILLE VIDE (passphrase SU perdue) — action destructive :\n");
            fwrite(STDOUT, "   • tous les administrateurs perdent leurs droits\n");
            fwrite(STDOUT, "   • toutes les sessions sont coupées, les demandes en attente tombent\n");
            fwrite(STDOUT, "   • le journal courant est figé et rangé (rouvrable via une sauvegarde scellée)\n");
            fwrite(STDOUT, "   • un journal vierge démarre — pose ensuite une nouvelle passphrase\n\n");
            fwrite(STDOUT, "   Relance avec --confirm pour exécuter.\n");
            exit(1);
        }
        $db = Db::pdo();
        // Le seul geste qui lève la garde du dernier administrateur, et seulement
        // le temps de sa transaction.
        $db->beginTransaction();
        $db->exec('UPDATE garde_admin SET reset_en_cours = 1 WHERE id = 1');
        $n = $db->exec('UPDATE accounts SET is_admin = 0 WHERE is_admin = 1');
        $db->exec('UPDATE garde_admin SET reset_en_cours = 0 WHERE id = 1');
        $db->exec('DELETE FROM app_sessions');
        $db->exec("DELETE FROM admin_requests WHERE status = 'pending'");
        $db->commit();

        $frozen = su_figer(SuAudit::logPath(), (new DateTime('now', new DateTimeZone('UTC')))->format('Ymd-His'));
        SuAudit::append(SuAudit::ACTION_RESET_SHELL, 'ALL-ADMINS', [
            'revoked_admins' => (int) $n,
            'frozen_log'     => $frozen ? basename($frozen) : null,
        ]);
        su_ok("Coquille vide : $n administrateur(s) révoqué(s), sessions coupées, demandes purgées.");
        if ($frozen) {
            fwrite(STDOUT, '   Ancien journal figé → ' . basename($frozen) . "\n");
        }
        fwrite(STDOUT, "   ⚠️  Pose maintenant une nouvelle passphrase SU, puis `first-admin` : la voie est rouverte.\n");
        break;

    case 'reset-db':
        // Kill all : quand un compte peut avoir été trafiqué, rien ne permet de le
        // reconnaître de l'intérieur — un intrus qui a tenu la base a pu remplacer
        // un `pw_hash` ou ajouter un compte qui ressemble aux autres. On ne trie
        // pas : tout part, et chacun se réinscrit.
        //
        // La base et le secret SU sont RENOMMÉS, jamais détruits : c'est la pièce
        // à conviction. Renommer plutôt que vider garantit qu'aucune table n'est
        // oubliée, y compris celles qui n'ont pas de clé étrangère vers `accounts`.
        // Le journal, lui, est GARDÉ : le reset s'y lit au milieu de ce qui précède.
        su_authenticate();
        $db    = Db::pdo();
        $bilan = [
            'comptes'  => (int) $db->query('SELECT COUNT(*) FROM accounts')->fetchColumn(),
            'admins'   => su_nb_admins($db),
            'sessions' => (int) $db->query('SELECT COUNT(*) FROM app_sessions')->fetchColumn(),
            'litiges'  => (int) $db->query('SELECT COUNT(*) FROM disputes')->fetchColumn(),
        ];
        if (!in_array('--confirm', $argv, true)) {
            fwrite(STDOUT, "⚠️  RESET-DB (compromission) — tout ce qui suit est SUPPRIMÉ du service :\n");
            fwrite(STDOUT, "   • {$bilan['comptes']} compte(s), dont {$bilan['admins']} administrateur(s)\n");
            fwrite(STDOUT, "   • {$bilan['sessions']} session(s), {$bilan['litiges']} litige(s), appareils, codes de secours\n");
            fwrite(STDOUT, "   • le secret SU : il faudra en reposer un, comme à l'installation\n");
            fwrite(STDOUT, "   La base et le secret sont mis de côté, jamais détruits ; le journal est gardé.\n\n");
            fwrite(STDOUT, "   Relance avec --confirm pour exécuter.\n");
            exit(1);
        }

        $source = su_empreinte_secret()['source'] ?? null;
        $quand  = (new DateTime('now', new DateTimeZone('UTC')))->format('Ymd-His');
        Db::fermer();
        $db = null;
        $baseFigee = su_figer(Db::path(), $quand);
        foreach (['-wal', '-shm', '-journal'] as $suffixe) {
            su_figer(Db::path() . $suffixe, $quand);
        }
        $secretFige = su_figer(su_secret_path(), $quand);

        SuAudit::append(SuAudit::ACTION_RESET_DB, 'ALL-ACCOUNTS', $bilan + [
            'base_figee'   => $baseFigee ? basename($baseFigee) : null,
            'secret_fige'  => $secretFige ? basename($secretFige) : null,
        ]);
        $restants = (int) Db::pdo()->query('SELECT COUNT(*) FROM accounts')->fetchColumn();
        if ($restants !== 0) {
            su_fail("La base rouverte porte encore $restants compte(s) : " . Db::path() . ' n\'a pas été remplacée.');
        }

        su_ok("Reset-db : {$bilan['comptes']} compte(s) supprimé(s), base neuve, journal gardé.");
        fwrite(STDOUT, '   Base figée   → ' . ($baseFigee ? basename($baseFigee) : '(aucune)') . "\n");
        fwrite(STDOUT, '   Secret figé  → ' . ($secretFige ? basename($secretFige) : '(aucun fichier)') . "\n");
        if ($source === 'SELFRECOVER_SU_SECRET') {
            fwrite(STDOUT, "   🚨 Le secret SU vient de l'environnement : aucun fichier ne peut le retirer.\n");
            fwrite(STDOUT, "      Retire SELFRECOVER_SU_SECRET, sinon l'ancienne passphrase vaut toujours.\n");
        }
        fwrite(STDOUT, "   Ensuite : un secret SU neuf (SELFRECOVER_SU_SECRET le temps d'un `change-passphrase`),\n");
        fwrite(STDOUT, "   l'inscription du futur admin, puis `first-admin` — la voie est rouverte.\n");
        fwrite(STDOUT, "   ⚠️  Ce reset ne chasse pas un intrus qui a la main sur le SERVEUR, et ne tourne ni le\n");
        fwrite(STDOUT, "      sel d'instance (.sitesalt) ni les secrets serveur : ces gestes-là sont à part.\n");
        break;

    default:
        fwrite(STDOUT, "selfrecover-su — console SuperUser (SU→Admin→User)\n\n");
        fwrite(STDOUT, "  first-admin <username>         nomme le premier administrateur — une fois, rouverte par un reset\n");
        fwrite(STDOUT, "  revoke-admin <username>        révoque un administrateur et coupe ses sessions (jamais le dernier)\n");
        fwrite(STDOUT, "    … --remplacant <username>    révoque et nomme le successeur dans le même geste\n");
        fwrite(STDOUT, "  list-admins                    liste les administrateurs\n");
        fwrite(STDOUT, "  list-requests                  demandes de promotion en attente\n");
        fwrite(STDOUT, "  approve-request <id> \"<obs>\"   valide une demande, observation obligatoire\n");
        fwrite(STDOUT, "  reject-request  <id> \"<obs>\"   refuse une demande\n");
        fwrite(STDOUT, "  audit [--dry-run]              croise base et journal, met les fantômes en quarantaine\n");
        fwrite(STDOUT, "  show-log [N]                   affiche le journal\n");
        fwrite(STDOUT, "  verify-log                     contrôle l'intégrité de la chaîne, et le sceau du secret\n");
        fwrite(STDOUT, "  record-seal                    note l'empreinte du secret en place, sans le changer\n");
        fwrite(STDOUT, "  change-passphrase              change la passphrase SU\n");
        fwrite(STDOUT, "  backup-log <dest>              scelle le journal pour le hors-site\n");
        fwrite(STDOUT, "  restore-log <scellé>           relit une sauvegarde scellée\n");
        fwrite(STDOUT, "  reset-shell --confirm          coquille vide (passphrase perdue) : révoque les admins\n");
        fwrite(STDOUT, "  reset-db --confirm             compromission : supprime TOUS les comptes et le secret SU\n\n");
        fwrite(STDOUT, "`add-admin` est retiré : le premier admin passe par `first-admin`, les suivants par une demande.\n");
        fwrite(STDOUT, "État hors site servi : SELFRECOVER_STATE_DIR. Secret du journal : SELFRECOVER_SU_AUDIT_SECRET.\n");
        break;
}
