#!/usr/bin/env php
<?php
/**
 * selfrecover-su — CLI SuperUser (modèle SU→Admin→User, option a : ANCRÉE SERVEUR).
 *
 * Le SU n'est PAS en DB. Auth = secret SU (SELFRECOVER_SU_SECRET, l'ex-ADMIN_TOKEN promu),
 * posé à l'install hors DB. Aucune interface distante : cette CLI s'exécute SUR le serveur.
 * Seul le SU crée/révoque des admins. Chaque action est écrite au log SU (append-only + chaîné).
 */

if (PHP_SAPI !== 'cli') { fwrite(STDERR, "CLI uniquement.\n"); exit(1); }

require __DIR__ . '/api/db.php';
require __DIR__ . '/api/su_audit.php';

$argv0 = 'selfrecover-su';
$cmd = $argv[1] ?? '';

function su_fail(string $m, int $code = 1) { fwrite(STDERR, "❌ $m\n"); exit($code); }
function su_ok(string $m): void { fwrite(STDOUT, "✅ $m\n"); }

/** Lit une saisie SANS l'afficher au terminal (masque la passphrase : épaule, screenshot, historique). */
function su_prompt_hidden(string $label): string {
    fwrite(STDOUT, $label);
    $tty = stripos(PHP_OS, 'WIN') === false && @shell_exec('stty 2>/dev/null') !== null;
    if ($tty) @shell_exec('stty -echo 2>/dev/null');
    $v = rtrim((string)fgets(STDIN), "\r\n");   // ne trim QUE le saut de ligne (garde d'éventuels espaces internes)
    if ($tty) { @shell_exec('stty echo 2>/dev/null'); fwrite(STDOUT, "\n"); }
    return $v;
}

/** Chemin du fichier secret SU (posé/modifié par change-passphrase). HORS webroot (STATE_DIR). */
function su_secret_path(): string {
    return getenv('SELFRECOVER_SU_SECRET_FILE')
        ?: ((getenv('SELFRECOVER_STATE_DIR') ?: __DIR__) . '/su-secret');
}
/** Secret SU EFFECTIF : le FICHIER a priorité (change-passphrase) ; sinon l'ENV (bootstrap à l'install). */
function su_expected_secret(): ?string {
    $f = su_secret_path();
    if (is_file($f)) { $h = trim((string)@file_get_contents($f)); if ($h !== '') return $h; }
    $e = getenv('SELFRECOVER_SU_SECRET');
    return ($e !== false && $e !== '') ? $e : null;
}
/** Auth SU : secret hors DB (fichier prioritaire, sinon env). Prompt, ou env SELFRECOVER_SU_SECRET_INPUT (tests). */
function su_authenticate(): string {
    $expected = su_expected_secret();
    if ($expected === null) su_fail("Secret SU non configuré (ni fichier " . su_secret_path() . ", ni env) — à poser à l'install.", 2);
    $given = getenv('SELFRECOVER_SU_SECRET_INPUT');
    if ($given === false) { $given = su_prompt_hidden("Passphrase SuperUser (actuelle) : "); }
    // Prod : hash Argon2/bcrypt → password_verify. Bootstrap dev : clair → hash_equals.
    $isHash = preg_match('/^\$(argon2|2y|2a|2b)/', (string)$expected) === 1;
    $ok = $isHash ? password_verify((string)$given, (string)$expected) : hash_equals((string)$expected, (string)$given);
    if (!$ok) su_fail("Secret SU invalide.", 3);
    return (string)$given; // passphrase en clair (dérive la clé de backup, label distinct)
}

/** Clé de chiffrement du backup, dérivée de la passphrase SU avec un LABEL DISTINCT de l'auth. */
function su_backup_key(string $passphrase): string {
    return hash('sha256', $passphrase . '|su-audit-backup', true); // 32 octets
}

function findUser(PDO $db, string $username): ?array {
    $st = $db->prepare("SELECT id, username, is_admin FROM users WHERE username = ?");
    $st->execute([$username]);
    return $st->fetch() ?: null;
}

// Garde-fou prod « fail fast » : en mode prod (DEBUG_MODE=false), aucun secret de démo toléré.
if (!DEBUG_MODE) {
    if (su_expected_secret() === 'demo-su-secret')
        su_fail("Secret SU = valeur démo interdite en prod (fais un change-passphrase, ou pose un hash Argon2).", 78);
    $au = getenv('SELFRECOVER_SU_AUDIT_SECRET');
    if (!$au || $au === 'dev-su-audit-secret-CHANGE-IN-PROD')
        su_fail("SELFRECOVER_SU_AUDIT_SECRET absent ou = valeur démo en prod (fixe-le à l'install).", 78);
}

switch ($cmd) {

case 'add-admin':
    su_authenticate();
    $u = $argv[2] ?? su_fail("usage: $argv0 add-admin <username>");
    $db = getDB();
    $user = findUser($db, $u) ?: su_fail("Utilisateur « $u » introuvable.");
    if ((int)$user['is_admin'] === 1) su_fail("« $u » est déjà admin.");
    $db->prepare("UPDATE users SET is_admin = 1 WHERE id = ?")->execute([$user['id']]);
    su_audit_append('add-admin', $u);
    su_ok("« $u » promu admin (loggé).");
    break;

case 'revoke-admin':
    su_authenticate();
    $u = $argv[2] ?? su_fail("usage: $argv0 revoke-admin <username>");
    $db = getDB();
    $user = findUser($db, $u) ?: su_fail("Utilisateur « $u » introuvable.");
    if ((int)$user['is_admin'] !== 1) su_fail("« $u » n'est pas admin.");
    $db->prepare("UPDATE users SET is_admin = 0 WHERE id = ?")->execute([$user['id']]);
    $db->prepare("DELETE FROM sessions WHERE user_id = ?")->execute([$user['id']]); // coupe ses sessions
    su_audit_append('revoke-admin', $u);
    su_ok("« $u » révoqué (sessions coupées, loggé).");
    break;

case 'list-admins':
    su_authenticate();
    $rows = getDB()->query("SELECT username FROM users WHERE is_admin = 1 ORDER BY username")->fetchAll();
    if (!$rows) { fwrite(STDOUT, "Aucun admin.\n"); break; }
    fwrite(STDOUT, "Admins (" . count($rows) . ") :\n");
    foreach ($rows as $r) fwrite(STDOUT, "  · {$r['username']}\n");
    break;

case 'list-requests':
    su_authenticate();
    $rows = getDB()->query("SELECT id, requester_username, target_username, reason, created_at FROM admin_requests WHERE status='pending' ORDER BY id")->fetchAll();
    if (!$rows) { fwrite(STDOUT, "Aucune demande en attente.\n"); break; }
    fwrite(STDOUT, "Demandes en attente :\n");
    foreach ($rows as $r) fwrite(STDOUT, "  #{$r['id']}  {$r['requester_username']} → promouvoir {$r['target_username']}" . ($r['reason'] ? "  ({$r['reason']})" : '') . "  [{$r['created_at']}]\n");
    break;

case 'approve-request':
    su_authenticate();
    $id = $argv[2] ?? su_fail("usage: $argv0 approve-request <id> \"<observation>\"");
    $note = $argv[3] ?? su_fail("Observation obligatoire.");
    $db = getDB();
    $st = $db->prepare("SELECT * FROM admin_requests WHERE id = ? AND status='pending'"); $st->execute([$id]);
    $req = $st->fetch() ?: su_fail("Demande #$id introuvable ou déjà traitée.");
    $user = findUser($db, $req['target_username']) ?: su_fail("Cible « {$req['target_username']} » introuvable.");
    $db->beginTransaction();
    $db->prepare("UPDATE users SET is_admin = 1 WHERE id = ?")->execute([$user['id']]);
    $db->prepare("UPDATE admin_requests SET status='approved', su_note=?, decided_at=CURRENT_TIMESTAMP WHERE id=?")->execute([$note, $id]);
    $db->commit();
    su_audit_append('approve-request', $req['target_username'], [
        'request_id'   => (int)$id,
        'requester'    => $req['requester_username'],   // qui a demandé
        'reason'       => $req['reason'],               // pourquoi
        'requested_at' => $req['created_at'],           // quand la demande a été faite
        'su_note'      => $note,                         // observation du SU à la validation
    ]);
    su_ok("Demande #$id approuvée — « {$req['target_username']} » promu admin (loggé).");
    break;

case 'reject-request':
    su_authenticate();
    $id = $argv[2] ?? su_fail("usage: $argv0 reject-request <id> \"<observation>\"");
    $note = $argv[3] ?? su_fail("Observation obligatoire.");
    $db = getDB();
    $st = $db->prepare("SELECT * FROM admin_requests WHERE id = ? AND status='pending'"); $st->execute([$id]);
    $req = $st->fetch() ?: su_fail("Demande #$id introuvable ou déjà traitée.");
    $db->prepare("UPDATE admin_requests SET status='rejected', su_note=?, decided_at=CURRENT_TIMESTAMP WHERE id=?")->execute([$note, $id]);
    su_audit_append('reject-request', $req['target_username'], [
        'request_id'   => (int)$id,
        'requester'    => $req['requester_username'],
        'reason'       => $req['reason'],
        'requested_at' => $req['created_at'],
        'su_note'      => $note,
    ]);
    su_ok("Demande #$id refusée (loggé).");
    break;

case 'audit':
    su_authenticate();
    $dryRun = in_array('--dry-run', $argv, true);
    $db = getDB();
    $admins = array_column($db->query("SELECT username FROM users WHERE is_admin = 1")->fetchAll(), 'username');
    $legit = [];
    foreach (su_audit_read() as $e) {
        $t = $e['target'] ?? null; if (!$t) continue;
        if (in_array($e['action'], ['add-admin', 'approve-request'], true)) $legit[$t] = true;
        elseif (in_array($e['action'], ['revoke-admin', 'reset-shell', 'quarantine-ghost'], true)) unset($legit[$t]);
    }
    $ghosts = array_values(array_diff($admins, array_keys($legit)));
    $ver = su_audit_verify();
    fwrite(STDOUT, "Log : " . ($ver['ok'] ? "✅ intègre ({$ver['count']} entrées)" : "🚨 ROMPU à l'entrée {$ver['break_at']} — {$ver['reason']}") . "\n");
    if ($ghosts) {
        fwrite(STDOUT, "🚨 ADMIN(S) FANTÔME(S) — is_admin=1 SANS entrée de création au log :\n");
        foreach ($ghosts as $g) {
            if ($dryRun) { fwrite(STDOUT, "   ⚠️  $g  (--dry-run : NON bloqué)\n"); continue; }
            // QUARANTAINE AUTO : révoque + coupe les sessions + logge (bloqué dès qu'on s'en rend compte)
            $db->prepare("UPDATE users SET is_admin = 0 WHERE username = ?")->execute([$g]);
            $db->prepare("DELETE FROM sessions WHERE user_id = (SELECT id FROM users WHERE username = ?)")->execute([$g]);
            su_audit_append('quarantine-ghost', $g, ['reason' => 'is_admin=1 sans entrée de création au log']);
            fwrite(STDOUT, "   🔒 $g → QUARANTAINE AUTO (droits révoqués + sessions coupées + loggé)\n");
        }
        exit(4);
    }
    fwrite(STDOUT, "✅ Aucun admin fantôme : les " . count($admins) . " admin(s) DB correspondent au log.\n");
    break;

case 'verify-log':
    su_authenticate();
    $ver = su_audit_verify();
    if ($ver['ok']) su_ok("Chaîne intègre — {$ver['count']} entrées, aucune altération.");
    else su_fail("🚨 Chaîne ROMPUE à l'entrée {$ver['break_at']} : {$ver['reason']}", 4);
    break;

case 'show-log':
case 'log':
    su_authenticate();
    $logPath = su_audit_log_path();
    if (!file_exists($logPath)) su_fail("Aucun log ($logPath).");
    $lines = file($logPath, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    $limit = isset($argv[2]) ? max(1, (int)$argv[2]) : count($lines);   // show-log [N] = N dernières
    $slice = array_slice($lines, -$limit);
    fwrite(STDOUT, "Log SU — " . count($lines) . " entrée(s)" . ($limit < count($lines) ? " (dernières $limit)" : "") . " · $logPath\n");
    fwrite(STDOUT, str_repeat('─', 60) . "\n");
    foreach ($slice as $line) {
        $e = json_decode($line, true);
        if (!is_array($e)) { fwrite(STDOUT, "  ⚠ ligne illisible\n"); continue; }
        $f = $e['forensic'] ?? [];
        $who = (!empty($f['operator']) ? $f['operator'] . '  ·  ' : '')
             . ($f['unix_user'] ?? '?') . '@' . ($f['ssh_client_ip'] ?: 'local')
             . ' tty=' . ($f['tty'] ?? '?') . ' pid=' . ($f['pid'] ?? '?');
        fwrite(STDOUT, sprintf("#%-3s %s  %s%s\n",
            $e['seq'] ?? '?', $e['ts_paris'] ?? ($e['ts_utc'] ?? '?'),
            $e['action'] ?? '?', isset($e['target']) && $e['target'] !== '' ? " → {$e['target']}" : ''));
        $extra = $e['extra'] ?? [];
        if (!empty($extra['observation'])) fwrite(STDOUT, "     obs : {$extra['observation']}\n");
        foreach ($extra as $k => $v) { if ($k === 'observation') continue; if (is_scalar($v)) fwrite(STDOUT, "     $k : $v\n"); }
        fwrite(STDOUT, "     par  : $who\n");
        fwrite(STDOUT, "     hash : " . substr($e['entry_hash'] ?? '', 0, 12) . "…  hmac " . substr($e['hmac'] ?? '', 0, 12) . "…\n");
    }
    fwrite(STDOUT, str_repeat('─', 60) . "\n");
    fwrite(STDOUT, "Intégrité : lance «$argv0 verify-log» pour contrôler la chaîne.\n");
    break;

case 'change-passphrase':
case 'set-passphrase':
    su_authenticate(); // valide l'ancien secret (fichier ou env bootstrap)
    $n1 = getenv('SELFRECOVER_SU_NEW_INPUT'); // tests non-interactifs
    if ($n1 === false) {
        $n1 = su_prompt_hidden("Nouvelle passphrase SU : ");
        $n2 = su_prompt_hidden("Confirme la nouvelle passphrase : ");
        if ($n1 !== $n2) su_fail("Les deux saisies diffèrent — rien changé.");
    }
    if (strlen((string)$n1) < 8) su_fail("Passphrase trop courte (8 caractères minimum).");
    $newHash = password_hash((string)$n1, PASSWORD_ARGON2ID);
    $secPath = su_secret_path();
    if (@file_put_contents($secPath, $newHash) === false) su_fail("Écriture impossible : $secPath (dossier accessible en écriture ?).");
    @chmod($secPath, 0600);
    su_audit_append('change-passphrase', 'SU', ['store' => basename($secPath), 'algo' => 'argon2id']); // JAMAIS la passphrase au log
    su_ok("Passphrase SU changée — hash Argon2 stocké dans $secPath. L'ancienne (et l'env bootstrap) ne valent plus rien.");
    break;

case 'backup-log':
    $pass = su_authenticate();
    $dest = $argv[2] ?? su_fail("usage: $argv0 backup-log <fichier-destination>");
    $logPath = su_audit_log_path();
    if (!file_exists($logPath)) su_fail("Aucun log à sauvegarder ($logPath).");
    $key = su_backup_key($pass);
    $iv = random_bytes(12); $tag = '';
    $cipher = openssl_encrypt(file_get_contents($logPath), 'aes-256-gcm', $key, OPENSSL_RAW_DATA, $iv, $tag);
    if ($cipher === false) su_fail("Chiffrement échoué.");
    $sealed = "SRSU1\n" . base64_encode($iv) . "\n" . base64_encode($tag) . "\n" . base64_encode($cipher) . "\n";
    if (@file_put_contents($dest, $sealed) === false) su_fail("Écriture $dest impossible.");
    @chmod($dest, 0600);
    su_audit_append('backup-log', basename($dest)); // le backup est lui-même tracé
    su_ok("Log scellé → $dest (AES-256-GCM · clé dérivée passphrase SU, label su-audit-backup).");
    fwrite(STDOUT, "   → à copier HORS-SITE (pas le NAS). Restauration : $argv0 restore-log $dest\n");
    break;

case 'restore-log':
    $pass = su_authenticate();
    $src = $argv[2] ?? su_fail("usage: $argv0 restore-log <fichier-scellé>");
    if (!file_exists($src)) su_fail("Fichier introuvable : $src.");
    $lines = file($src, FILE_IGNORE_NEW_LINES);
    if (($lines[0] ?? '') !== 'SRSU1') su_fail("Format scellé invalide.");
    $plain = openssl_decrypt(base64_decode($lines[3] ?? ''), 'aes-256-gcm', su_backup_key($pass),
                             OPENSSL_RAW_DATA, base64_decode($lines[1] ?? ''), base64_decode($lines[2] ?? ''));
    if ($plain === false) su_fail("Déchiffrement échoué (mauvaise passphrase ou fichier altéré).", 4);
    fwrite(STDOUT, $plain);
    break;

case 'forgot-passphrase':
case 'reset-shell':
    // COQUILLE VIDE : le SU a OUBLIÉ la passphrase → il déclenche ce reset (accès serveur = autorisation,
    // option a). N'exige PAS la passphrase (perdue). Le log se fige + se range, un log vierge démarre.
    if (!in_array('--confirm', $argv, true)) {
        fwrite(STDOUT, "⚠️  COQUILLE VIDE (passphrase SU oubliée) — action DESTRUCTIVE :\n");
        fwrite(STDOUT, "   • TOUS les admins perdent leurs droits (chaîne validée par l'ancien SU = plus fiable)\n");
        fwrite(STDOUT, "   • toutes les sessions sont coupées, les demandes en attente tombent\n");
        fwrite(STDOUT, "   • le log courant est FIGÉ + rangé (dort ; réouvrable via un backup scellé + l'ancienne passphrase)\n");
        fwrite(STDOUT, "   • un log vierge démarre — pose ensuite une NOUVELLE passphrase SU\n\n");
        fwrite(STDOUT, "   Relance avec --confirm pour exécuter.\n");
        exit(1);
    }
    $db = getDB();
    $n = $db->exec("UPDATE users SET is_admin = 0 WHERE is_admin = 1");   // révoque tous les admins
    $db->exec("DELETE FROM sessions");                                    // coupe toutes les sessions
    $db->exec("DELETE FROM admin_requests WHERE status = 'pending'");     // les demandes en attente tombent
    $logPath = su_audit_log_path();
    $frozen = null;
    if (file_exists($logPath)) {
        $frozen = $logPath . '.frozen-' . (new DateTime('now', new DateTimeZone('UTC')))->format('Ymd-His');
        @rename($logPath, $frozen);                                       // fige + range l'ancien log
    }
    // Log vierge : 1re entrée = shell-reset (contexte forensique de QUI a déclenché la coquille)
    su_audit_append('shell-reset', 'ALL-ADMINS', ['revoked_admins' => (int)$n, 'frozen_log' => $frozen ? basename($frozen) : null]);
    su_ok("Coquille vide : {$n} admin(s) révoqué(s), sessions coupées, demandes purgées.");
    if ($frozen) fwrite(STDOUT, "   Ancien log figé → " . basename($frozen) . " (dort).\n");
    fwrite(STDOUT, "   ⚠️  Pose maintenant une NOUVELLE passphrase SU (SELFRECOVER_SU_SECRET) avant toute promotion.\n");
    break;

default:
    fwrite(STDOUT, "selfrecover-su — CLI SuperUser (SU→Admin→User)\n\n");
    fwrite(STDOUT, "  add-admin <username>              promeut un user en admin\n");
    fwrite(STDOUT, "  revoke-admin <username>           révoque un admin (+ coupe ses sessions)\n");
    fwrite(STDOUT, "  list-admins                       liste les admins\n");
    fwrite(STDOUT, "  list-requests                     demandes de promotion en attente\n");
    fwrite(STDOUT, "  approve-request <id> \"<obs>\"      valide une demande (observation obligatoire)\n");
    fwrite(STDOUT, "  reject-request  <id> \"<obs>\"      refuse une demande\n");
    fwrite(STDOUT, "  audit                             croise admins DB ↔ log → fantômes\n");
    fwrite(STDOUT, "  show-log [N]                      affiche le log (N dernières entrées, sinon tout)\n");
    fwrite(STDOUT, "  verify-log                        intégrité de la chaîne du log\n");
    fwrite(STDOUT, "  change-passphrase                 change la passphrase SU (hash Argon2 stocké hors DB/webroot)\n");
    fwrite(STDOUT, "  backup-log <dest>                 scelle le log (chiffré passphrase SU) → à copier hors-site\n");
    fwrite(STDOUT, "  restore-log <scellé>              déchiffre un backup scellé (affiche le log)\n");
    fwrite(STDOUT, "  reset-shell --confirm             COQUILLE VIDE (passphrase oubliée) : fige le log, révoque tous les admins, repart vierge\n\n");
    fwrite(STDOUT, "Secret SU via SELFRECOVER_SU_SECRET (prompt à l'exécution).\n");
    break;
}
