# === SelfRecover — configuration PROD ===
# Copie ce fichier, remplis-le avec des valeurs FORTES et aléatoires, ne le commite JAMAIS rempli.
# En prod, DEBUG reste false (défaut) → le garde-fou « fail fast » refuse de démarrer
# tant que les secrets valent encore les valeurs de démo.

# --- Secrets (aléatoires forts) ---
# Anti-énumération de l'endpoint user-salt. Ex : openssl rand -hex 32
SELFRECOVER_SERVER_SECRET=

# Secret SuperUser = HASH Argon2 d'une passphrase (JAMAIS la passphrase en clair) :
#   php -r 'echo password_hash("ta-passphrase-diceware", PASSWORD_ARGON2ID), "\n";'
# Posé UNIQUEMENT dans l'environnement du CLI selfrecover-su (le serveur web n'en a pas besoin).
SELFRECOVER_SU_SECRET=

# Secret HMAC du log SU. FIXE une fois pour toutes à l'install (en pratique dérivé de la passphrase SU).
# Le changer rend TOUT l'historique invérifiable — c'est voulu. Ex : openssl rand -hex 32
SELFRECOVER_SU_AUDIT_SECRET=

# --- Externalisation du log SU (ntfy) ---
SELFRECOVER_NTFY_URL=https://ntfy.example/your-topic

# --- Chemins HORS webroot (writable ; le code reste immutable) ---
SELFRECOVER_DB_PATH=/var/lib/selfrecover/selfrecover.sqlite
SELFRECOVER_STATE_DIR=/var/lib/selfrecover
SELFRECOVER_SU_AUDIT_LOG=/var/lib/selfrecover/su-audit.log

# --- CORS : domaine public exact ---
SELFRECOVER_ORIGIN=https://exemple.tld

# --- Modes : laisser false/absents en prod (secure-by-default) ---
SELFRECOVER_DEBUG=false
SELFRECOVER_DEMO_PURGE=false
SELFRECOVER_FAST_TIMINGS=false
