#!/bin/sh
# Hook initramfs-tools — embarque la dérivation SelfRecover dans l'initrd.
# Destination d'install : /etc/initramfs-tools/hooks/selfrecover
#
# Copie : le binaire de dérivation (+ libargon2.so.1 tirée auto par copy_exec),
#         le sel du déploiement, et le keyscript appelé par cryptsetup.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "${1:-}" in prereqs) prereqs; exit 0 ;; esac

. /usr/share/initramfs-tools/hook-functions

# binaire de dérivation — copy_exec embarque aussi ses libs (libargon2.so.1)
copy_exec /etc/selfkeyguard/selfrecover_derive_c

# libgcc_s.so.1 : chargée à l'EXÉCUTION par pthread (argon2 multi-thread, parallelism=4),
# invisible à ldd → copy_exec ne la tire pas automatiquement. Sans elle : "libgcc_s.so.1
# must be installed for pthread_exit to work" -> Aborted -> bad password au boot.
# libgcc_s est chargee par dlopen depuis libargon2 : ldd ne la voit pas, copy_exec
# ne la tire donc pas. Sans elle, l'amorcage rend « libgcc_s.so.1 must be installed
# for pthread_exit » puis « bad password ».
# Le chemin depend de l'architecture : ldconfig d'abord, chemins connus ensuite. Un
# chemin amd64 code en dur ne trouvait rien sur arm64 — sans un mot, l'image se
# construisait quand meme, et la machine ne redemarrait plus.
_LIBGCC=$(ldconfig -p 2>/dev/null | awk '/libgcc_s\.so\.1 /{print $NF; exit}')
if [ -z "$_LIBGCC" ] || [ ! -e "$_LIBGCC" ]; then
  for _C in /lib/*/libgcc_s.so.1 /usr/lib/*/libgcc_s.so.1 /lib/libgcc_s.so.1; do
    [ -e "$_C" ] && { _LIBGCC="$_C"; break; }
  done
fi
if [ -n "$_LIBGCC" ] && [ -e "$_LIBGCC" ]; then
  copy_exec "$_LIBGCC"
else
  # Echouer ici plutot que produire une image qui ne demarrera pas.
  echo "selfrecover: libgcc_s.so.1 introuvable — image non amorcable, arret." >&2
  exit 1
fi

# keyscript appelé par cryptsetup au boot
copy_exec /etc/selfkeyguard/selfrecover-keyscript.sh

# sel propre au déploiement (non secret, mais nécessaire à la dérivation)
mkdir -p "$DESTDIR/etc/selfkeyguard"
cp -a /etc/selfkeyguard/selfrecover_salt "$DESTDIR/etc/selfkeyguard/selfrecover_salt"
