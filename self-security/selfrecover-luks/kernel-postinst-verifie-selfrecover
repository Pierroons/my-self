#!/bin/sh
# /etc/kernel/postinst.d/zz-verifie-selfrecover
#
# S'execute APRES la generation de l'initramfs lors d'une mise a jour de noyau.
# Verifie que toutes les pieces SelfRecover y sont. Sans ce controle, une
# regression du hook produirait un initramfs muet — l'echec n'apparaitrait
# qu'au redemarrage suivant, sur une machine devenue non amorcable.
#
# C'est la reponse au cout reel du module (rapport §5.3.b) : ce n'est pas la
# cryptographie qui est fragile, c'est le nombre de pieces dans le chemin
# d'amorcage.
set -e
VER="$1"
INITRD="/boot/initrd.img-$VER"
[ -f "$INITRD" ] || exit 0
grep -q "keyscript=.*selfrecover" /etc/crypttab 2>/dev/null || exit 0   # module non actif

# `lsinitramfs | grep -q` : grep s'arrete au premier match, lsinitramfs recoit un
# SIGPIPE. Sans `set -o pipefail`, le pipeline rend le code de grep et le test est
# juste. NE PAS ajouter pipefail a ce script : le test s'inverserait en silence, et
# un initramfs incomplet passerait pour complet. Ce mecanisme exact a deja retourne
# un controle d'exclusion tar pendant ce deploiement.
MANQUE=""
for piece in \
  "selfkeyguard/selfrecover_derive_c:binaire de derivation" \
  "selfkeyguard/selfrecover_salt:sel de deploiement" \
  "selfkeyguard/selfrecover-keyscript:keyscript" \
  "libargon2:libargon2" \
  "libgcc_s:libgcc_s" \
  "usr/sbin/cryptsetup:cryptsetup"
do
  motif="${piece%%:*}"; nom="${piece#*:}"
  lsinitramfs "$INITRD" 2>/dev/null | grep -q "$motif" || MANQUE="$MANQUE
    - $nom"
done

if [ -n "$MANQUE" ]; then
  cat >&2 <<MSG

  ############################################################
  ##  ALERTE SelfRecover-LUKS — NE PAS REDEMARRER           ##
  ############################################################

  L'initramfs $VER qui vient d'etre genere ne contient pas :$MANQUE

  Le keyscript est actif dans /etc/crypttab : au prochain demarrage,
  le volume racine ne pourra pas etre deverrouille.

  A FAIRE AVANT DE REDEMARRER :
    1. verifier /etc/initramfs-tools/hooks/selfrecover et /etc/selfkeyguard/
    2. relancer : update-initramfs -u -k $VER
    3. relancer ce controle
  Repli : demarrer sur un initrd .pre-selfrecover, ou retirer keyscript=
          de /etc/crypttab depuis un systeme de secours (le slot natif
          ouvre toujours le volume).

  ############################################################

MSG
  exit 1
fi
echo "SelfRecover-LUKS : initramfs $VER complet (binaire, sel, keyscript, libargon2, libgcc_s, cryptsetup)."
