#!/bin/sh
# /etc/initramfs/post-update.d/zz-verifie-selfrecover
#
# S'execute apres CHAQUE generation d'initramfs. Verifie que les pieces
# SelfRecover y sont, que le sel embarque est bien celui du disque, et que la
# borne keyfile-size de la crypttab embarquee est la longueur de la cle que
# presente le keyscript embarque. Sans ce controle, une regression du hook
# produit un initramfs muet : l'echec n'apparait qu'au redemarrage, sur une
# machine devenue non amorcable.
#
# post-update.d et non kernel/postinst.d : update-initramfs est declenche par une
# mise a jour de noyau, mais aussi par cryptsetup-initramfs, busybox,
# initramfs-tools, ou a la main. Seul post-update.d couvre tous ces chemins, et
# c'est justement une mise a jour de cryptsetup-initramfs qui casserait ce module.
#
# run-parts fournit : $1 = version du noyau, $2 = chemin de l'image generee.
set -e
VER="${1:?version attendue}"
INITRD="${2:-/boot/initrd.img-$VER}"
# Les trois racines sont surchargeables par l'environnement, avec les chemins
# reels par defaut. Sans cela ce controle n'etait epprouvable que sur une machine
# amorcable — c'est-a-dire nulle part, et c'est pourquoi il a pu viser la mauvaise
# cible pendant des mois sans que personne le voie. Le banc tests/ s'en sert pour
# le faire ROUGIR sur le cas du 13/09.
SKG="${SKG:-/etc/selfkeyguard}"
CRYPTTAB="${CRYPTTAB:-/etc/crypttab}"
FW="${FW:-/boot/firmware}"

[ -f "$INITRD" ] || exit 0
# Une ligne active, pas un commentaire : le controle de la crypttab embarquee
# ci-dessous exige que l'image en porte une des qu'ici il y en a une.
grep -q '^[[:space:]]*[^#[:space:]].*keyscript=[^,]*selfrecover' "$CRYPTTAB" 2>/dev/null \
  || exit 0   # module non actif

# --- QUELLE image l'amorceur charge-t-il vraiment ? ---
#
# Ce script ne verifiait que $INITRD, c'est-a-dire l'image qu'update-initramfs
# VIENT DE PRODUIRE. Sur x86+GRUB les deux coincident, donc il n'a jamais pu se
# tromper — et personne ne pouvait voir qu'il visait la mauvaise cible.
#
# Sur un Raspberry Pi, l'amorceur lit config.txt dans la partition firmware et y
# charge une AUTRE copie. Le 13/09/2026 la machine a demarre sur une image sans
# une seule piece SelfRecover, pendant que ce controle affichait « complet » :
# l'image a jour n'avait pas ete copiee, et raspi-firmware avait promu une
# sauvegarde .bak.* du module en image d'amorcage. Le filet etait devenu la cible.
#
# 🔑 Un controle qui ne vise pas la bonne cible est pire qu'une absence de
#    controle : il rassure.
#
# L'ordonnancement le permet : dans /etc/initramfs/post-update.d/,
# z50-raspi-firmware s'execute AVANT zz-verifie-selfrecover (ordre lexical), donc
# la partition d'amorcage est deja a jour quand ce controle tourne.
# ($FW est declare plus haut, surchargeable pour le banc.)
CHARGEE=""
if [ -r "$FW/config.txt" ]; then
  # Derniere ligne gagnante : config.txt se lit de haut en bas, une directive
  # repetee ecrase la precedente.
  _NOM=$(sed -n 's/^[[:space:]]*initramfs[[:space:]]\{1,\}\([^[:space:]]\{1,\}\).*/\1/p' \
         "$FW/config.txt" | tail -n 1)
  [ -n "$_NOM" ] && CHARGEE="$FW/$_NOM"
fi

# AVERTISSEMENT — NE PAS ajouter `set -o pipefail` a ce script.
# La boucle ci-dessous fait `lsinitramfs | grep -q`. Quand grep -q trouve, il
# s'arrete aussitot et lsinitramfs prend un SIGPIPE. Sous pipefail, le pipeline
# rendrait donc l'echec de l'amont au lieu du succes de grep : le test
# s'inverserait en silence, et le garde-fou declarerait "absent" une piece
# presente. Avec `set -e` seul, le pipeline rend le code de grep : correct.
PIECES="selfkeyguard/selfrecover_derive_c:binaire de derivation
selfkeyguard/selfrecover_salt:sel de deploiement
selfkeyguard/selfrecover-keyscript:keyscript
selfkeyguard/selfrecover-secours:script de secours (command= de dropbear)
libargon2:libargon2
libgcc_s:libgcc_s
usr/sbin/cryptsetup:cryptsetup"

# Renseigne ABSENTES et TROUVEES pour l'image passee en argument. Une fonction
# et non deux boucles : elle sert a l'image generee ET a l'image chargee, et deux
# inventaires recopies divergeraient a la premiere piece ajoutee.
inventorier() {
  _img="$1"; ABSENTES=""; TROUVEES=""
  _oldifs=$IFS; IFS='
'
  for _p in $PIECES; do
    _motif="${_p%%:*}"; _nom="${_p#*:}"
    if lsinitramfs "$_img" 2>/dev/null | grep -q "$_motif"; then
      TROUVEES="$TROUVEES, $_nom"
    else
      ABSENTES="$ABSENTES
    - $_nom"
    fi
  done
  IFS=$_oldifs
}

inventorier "$INITRD"
MANQUE="$ABSENTES"
PRESENTES="$TROUVEES"

# --- l'image chargee, quand ce n'est pas celle qu'on vient de produire ---
ALERTE_CHARGEE=""
if [ -n "$CHARGEE" ] && [ "$CHARGEE" != "$INITRD" ]; then
  if [ ! -f "$CHARGEE" ]; then
    ALERTE_CHARGEE="config.txt designe $CHARGEE, qui n'existe pas."
  else
    case "${CHARGEE##*/}" in
      *.bak.*|*.pre-selfrecover*)
        ALERTE_CHARGEE="l'amorceur charge une SAUVEGARDE du module ($CHARGEE),
    pas l'image courante. Un filet promu en cible : sors les .bak.* de /boot." ;;
    esac
    # Comparaison des dates par stat et non par `-nt` : l'operateur marche sous
    # dash mais n'est pas defini par POSIX (shellcheck SC3013), et ce script est
    # en /bin/sh. Une image chargee plus ancienne que celle qu'on vient de
    # produire veut dire que la copie vers la partition d'amorcage n'a pas eu lieu.
    _T_GEN=$(stat -c %Y "$INITRD" 2>/dev/null || echo 0)
    _T_CHG=$(stat -c %Y "$CHARGEE" 2>/dev/null || echo 0)
    if [ -z "$ALERTE_CHARGEE" ] && [ "$_T_GEN" -gt "$_T_CHG" ]; then
      ALERTE_CHARGEE="l'image chargee ($CHARGEE) est PLUS ANCIENNE que celle qui
    vient d'etre generee ($INITRD) : la copie vers la partition d'amorcage n'a pas eu lieu."
    fi
    if [ -z "$ALERTE_CHARGEE" ]; then
      inventorier "$CHARGEE"
      [ -n "$ABSENTES" ] && ALERTE_CHARGEE="pieces absentes de l'image CHARGEE
    ($CHARGEE) — l'image generee, elle, est complete :$ABSENTES"
    fi
  fi
fi

# Le sel embarque doit etre CELUI DU DISQUE. Un sel present mais perime derive une
# autre cle : le volume ne s'ouvre plus, et un controle de simple presence aurait
# affiche "complet". C'est le cas qui survient quand /etc/selfkeyguard/ est
# regenere sans que l'initramfs le soit.
#
# ⚠️ Cette comparaison peut ne pas s'executer, et son absence DOIT s'entendre.
# Sautee en silence, elle rendait le meme "complet" qu'une comparaison reussie :
# le faux vert que ce hook existe pour fermer, loge dans le hook. Trois etats
# sont donc distingues — concorde, differe, pas verifiable — et le mot "complet"
# est reserve au premier.
#
# La borne keyfile-size se juge au meme endroit, et sur les memes copies : celles
# de l'IMAGE PRODUITE. L'amorcage lit la crypttab que l'image embarque
# (cryptroot/crypttab), pas /etc/crypttab, et cryptsetup y lit EXACTEMENT la borne
# — une borne raw sous un keyscript hex tronque la cle. Comparer les fichiers du
# disque dirait vrai pendant que l'image dit autre chose. L'image chargee par
# l'amorceur (Raspberry Pi), elle, n'est inventoriee que pour ses pieces.
SEL_ECART=""
SEL_SAUTE=""
BORNE_ECART=""
BORNE_SAUTE=""
NOMS_ECART=""
CT_ECART=""""
if ! command -v unmkinitramfs >/dev/null 2>&1; then
  SEL_SAUTE="unmkinitramfs absent (paquet initramfs-tools-bin)"
  BORNE_SAUTE="$SEL_SAUTE"
else
  TMP=$(mktemp -d) || TMP=""
  if [ -z "$TMP" ]; then
    SEL_SAUTE="repertoire temporaire indisponible"
    BORNE_SAUTE="$SEL_SAUTE"
  else
    if ! unmkinitramfs "$INITRD" "$TMP" >/dev/null 2>&1; then
      SEL_SAUTE="extraction de l'image impossible"
      BORNE_SAUTE="$SEL_SAUTE"
    else
      # 🔑 `unmkinitramfs` n'extrait pas toujours a la racine. Une image portant
      # un segment de microcode — le cas de toute machine Intel ou AMD — est
      # eclatee en `early/`, `early2/`… et `main/` ; le systeme de fichiers de
      # l'initramfs est alors sous `main/`, jamais a la racine.
      #
      # ⚠️ Un chemin en dur `$TMP/etc/...` ne trouve donc rien sur ces machines,
      # et le controle rendait « sel absent de l'image extraite » — donc 0 — sur
      # des images parfaitement saines. Mesure du 15/09/2026 : les quatre images
      # d'un poste x86 en portaient toutes le sel sous `main/`, et le sel n'y a
      # jamais ete verifie une seule fois. C'est le defaut que ce hook existe
      # pour fermer, loge dans le hook — la seconde fois au meme endroit.
      SEL_IMAGE=$(find "$TMP" -path '*/etc/selfkeyguard/selfrecover_salt' \
                    -type f 2>/dev/null | head -1)
      if [ ! -r "$SKG/selfrecover_salt" ]; then
        SEL_SAUTE="$SKG/selfrecover_salt illisible"
      elif [ -z "$SEL_IMAGE" ]; then
        # La presence du sel est deja couverte par PIECES. Arriver ici veut dire
        # que l'image extraite ne montre pas ce que lsinitramfs annonce : a
        # signaler, pas a taire.
        SEL_SAUTE="sel absent de l'image extraite"
      else
        A=$(sha256sum < "$SKG/selfrecover_salt" | cut -d' ' -f1)
        B=$(sha256sum < "$SEL_IMAGE" | cut -d' ' -f1)
        [ "$A" = "$B" ] || SEL_ECART="oui"
      fi

      # Chaque ligne a keyscript SelfRecover de l'image, jugee avec le keyscript
      # qu'elle designe : c'est lui qui tournera. format-slot.sh tient la longueur
      # de cle de chaque format.
      CT_IMAGE=$(find "$TMP" -path '*/cryptroot/crypttab' -type f 2>/dev/null | head -1)
      LIGNES=""
      [ -n "$CT_IMAGE" ] && LIGNES=$(awk '$1 !~ /^#/ && $4 ~ /keyscript=[^,]*selfrecover/ {
                     k = ""; m = split($4, o, ",")
                     for (i = 1; i <= m; i++) if (o[i] ~ /^keyscript=/) k = substr(o[i], 11)
                     print $1, k }' "$CT_IMAGE")
      if [ -z "$CT_IMAGE" ] && [ -z "$SEL_IMAGE" ]; then
        # Ni crypttab ni sel : l'extraction n'a rien rendu de lisible.
        BORNE_SAUTE="crypttab absente de l'image extraite"
      elif [ -z "$LIGNES" ]; then
        # /etc/crypttab en porte une : l'image qui n'en a aucune n'ouvrira pas ce
        # volume. cryptsetup-initramfs ecarte en effet une entree dont une option est
        # invalide — keyfile-size=0 ou vide, keyscript non executable.
        CT_ECART="oui"
      elif [ ! -r "$SKG/format-slot.sh" ]; then
        BORNE_SAUTE="$SKG/format-slot.sh absent"
      else
        _IFS=$IFS; IFS='
'
        for _l in $LIGNES; do
          _nom=${_l%% *}; _ks=${_l#* }
          KS_IMAGE=$(find "$TMP" -path "*$_ks" -type f 2>/dev/null | head -1)
          if [ -z "$KS_IMAGE" ]; then
            BORNE_SAUTE="keyscript $_ks absent de l'image extraite"
            continue
          fi
          _RC=0
          BORNE_DIT=$(bash "$SKG/format-slot.sh" borne "$_nom" "$KS_IMAGE" "$CT_IMAGE" 2>&1) || _RC=$?
          case "$_RC" in
            0|3) ;;
            1) BORNE_ECART="$BORNE_ECART
  $(printf '%s\n' "$BORNE_DIT" | head -n 1)"
               NOMS_ECART="$NOMS_ECART $_nom" ;;
            *) BORNE_SAUTE="$_nom : format-slot.sh a rendu $_RC" ;;
          esac
        done
        IFS=$_IFS
      fi
    fi
    rm -rf "$TMP"
  fi
fi

if [ -n "$MANQUE" ] || [ -n "$SEL_ECART" ] || [ -n "$ALERTE_CHARGEE" ] || [ -n "$BORNE_ECART" ] \
   || [ -n "$CT_ECART" ]; then
  cat >&2 <<MSG

  ############################################################
  ##  ALERTE SelfRecover-LUKS — NE PAS REDEMARRER           ##
  ############################################################

  Image concernee : $INITRD
MSG
  [ -n "$CHARGEE" ] && printf '  Image chargee par l amorceur : %s\n' "$CHARGEE" >&2
  [ -n "$MANQUE" ] && printf '\n  Pieces absentes :%s\n' "$MANQUE" >&2
  [ -n "$ALERTE_CHARGEE" ] && printf '\n  IMAGE D AMORCAGE : %s\n' "$ALERTE_CHARGEE" >&2
  [ -n "$SEL_ECART" ] && printf '\n  Le sel embarque DIFFERE de %s/selfrecover_salt.\n  La derivation ne reproduira pas la cle du slot.\n' "$SKG" >&2
  [ -n "$CT_ECART" ] && printf '\n  La crypttab embarquee ne porte AUCUNE ligne a keyscript SelfRecover.\n  cryptsetup-initramfs ecarte une entree a option invalide : relire la ligne\n  de %s (keyfile-size, keyscript executable).\n' "$CRYPTTAB" >&2
  [ -n "$BORNE_ECART" ] && printf '\n  BORNE keyfile-size de la crypttab embarquee :%s\n' "$BORNE_ECART" >&2
  for _nom in $NOMS_ECART; do
    printf '  Corriger : bash %s/format-slot.sh borne %s %s/selfrecover-keyscript.sh %s --ecrire\n' \
      "$SKG" "$_nom" "$SKG" "$CRYPTTAB" >&2
  done
  cat >&2 <<MSG

  Le keyscript est actif dans /etc/crypttab : au prochain demarrage,
  le volume racine ne pourra pas etre deverrouille.

  A FAIRE AVANT DE REDEMARRER :
    1. verifier /etc/initramfs-tools/hooks/selfrecover et $SKG/
    2. relancer : update-initramfs -u -k $VER
    3. relancer ce controle
  Repli : demarrer sur un initrd .pre-selfrecover, ou retirer keyscript=
          de /etc/crypttab depuis un systeme de secours (le slot natif
          ouvre toujours le volume).

  ############################################################

MSG
  exit 1
fi

# La liste vient de la boucle, pas d'une seconde ecriture a la main : ajouter une
# piece ci-dessus suffit, le message suit.
# La cible controlee est NOMMEE — dans les DEUX branches ci-dessous. Dire
# « complet » sans dire de quelle image on parle est precisement ce qui a rassure
# a tort le 13/09 ; le dire seulement quand le sel a pu etre verifie laisserait le
# meme trou ouvert sur toute machine sans unmkinitramfs. Le troisieme cas ne se
# maquille pas en succes : quand la cible d'amorcage n'est pas resolue, ce script
# ne l'a pas verifiee, et il le dit au lieu de laisser croire a une concordance.
if [ -z "$CHARGEE" ]; then
  CIBLE="cible d amorcage non resolue (pas de $FW/config.txt) : seule l image generee est verifiee."
elif [ "$CHARGEE" = "$INITRD" ]; then
  CIBLE="l amorceur charge cette image meme ($CHARGEE)."
else
  CIBLE="image chargee par l amorceur verifiee et concordante : $CHARGEE"
fi

if [ -n "$SEL_SAUTE" ] || [ -n "$BORNE_SAUTE" ]; then
  # Pas d'exit 1 : une capacite manquante n'est pas une image cassee, et faire
  # echouer update-initramfs pousserait a desinstaller le hook. Mais la sortie
  # part sur stderr et ne dit pas "complet" — elle nomme ce qui reste a etablir.
  printf 'SelfRecover-LUKS : initramfs %s — pieces presentes (%s).\n' \
         "$VER" "${PRESENTES#, }" >&2
  printf '  %s\n' "$CIBLE" >&2
  [ -n "$SEL_SAUTE" ] && printf '  SEL NON VERIFIE : %s. La concordance du sel embarque reste a etablir.\n' \
         "$SEL_SAUTE" >&2
  [ -n "$BORNE_SAUTE" ] && printf '  BORNE NON VERIFIEE : %s. L accord de la borne keyfile-size et du keyscript reste a etablir.\n' \
         "$BORNE_SAUTE" >&2
else
  echo "SelfRecover-LUKS : initramfs $VER complet (${PRESENTES#, })."
  echo "  $CIBLE"
fi

# ---------------------------------------------------------------------------
# Consigner l'empreinte de l'image, HORS de /boot.
#
# 🔑 Ce que ce bloc ferme, et ce qu'il ne ferme pas. Condamner le shell du
# dropbear d'amorcage retire UN chemin vers /boot ; il en reste d'autres — un
# acces physique, et root sur la machine en marche. La classe ne se ferme pas,
# mais l'alteration peut devenir VISIBLE : l'empreinte est ecrite dans $SKG,
# qui vit sur le volume CHIFFRE, tandis que l'image vit sur /boot en clair. Qui
# modifie /boot sans ouvrir le volume ne peut pas mettre l'empreinte d'accord.
#
# Ce n'est pas un scellement TPM : ca ne protege pas la saisie qui suit
# immediatement l'alteration, et ca se contourne par quiconque a deja root sur
# la machine ouverte. Mais ca ne demande aucun materiel — le RPI4 du parc n'a
# pas de TPM — et ca rend l'ecart lisible par une commande, ce qu'aucun
# controle ne faisait jusqu'ici.
#
# L'ecriture est la derniere chose que fait ce script : consigner une empreinte
# avant d'avoir verifie les pieces reviendrait a certifier une image cassee.
EMPREINTES="${SKG}/initramfs.sha256"
if [ -d "$SKG" ] && [ -r "$INITRD" ]; then
  SOMME=$(sha256sum < "$INITRD" | cut -d' ' -f1)
  TMP="${EMPREINTES}.nouveau"
  # Les autres versions de noyau sont conservees : une machine porte souvent
  # l'image courante ET celle de secours, et effacer la ligne de la seconde
  # rendrait sa verification impossible sans la regenerer.
  [ -f "$EMPREINTES" ] && grep -v "^${VER}[[:space:]]" "$EMPREINTES" > "$TMP" 2>/dev/null || : > "$TMP"
  printf '%s\t%s\t%s\n' "$VER" "$SOMME" "$(date -Is)" >> "$TMP"
  mv "$TMP" "$EMPREINTES"
  chmod 0644 "$EMPREINTES"
  echo "  empreinte consignee hors de /boot : $EMPREINTES"
else
  # Ne pas echouer : une empreinte non consignee n'est pas une image cassee. Mais
  # ne pas se taire non plus — un controle qui n'a pas pu s'executer et qui ne le
  # dit pas est exactement ce que ce fichier existe pour eviter.
  echo "  empreinte NON consignee ($SKG absent, ou image illisible) : la verification d integrite sera impossible." >&2
fi
