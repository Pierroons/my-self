[Unit]
Description=Démo SelfDataGuard — efface les bases et les quotas que les visiteurs ont laissés
Documentation=https://github.com/Pierroons/my-self/blob/main/demo/selfdataguard/README.md
# Le répertoire naît à la première visite : avant elle, rien à purger, et pas d'échec.
ConditionPathIsDirectory=/var/lib/selfdataguard/sessions

[Service]
Type=oneshot
User=www-data
# 30 minutes = DEMO_TTL_SECONDES de demo/selfdataguard/api/_bootstrap.php, qui purge
# aussi à chaque requête ; le banc de la démo exige que les deux valeurs concordent.
# Tout ce que contient sessions/ est éphémère : les bases et les quotas par adresse.
ExecStart=/usr/bin/find /var/lib/selfdataguard/sessions -maxdepth 1 -type f -mmin +30 -delete
